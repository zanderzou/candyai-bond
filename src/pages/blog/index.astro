---
import{getCollection}from"astro:content";import BaseLayout from"../../layouts/BaseLayout.astro";import PostCard from"../../components/PostCard.astro";import{site}from"../../data/site";const posts=(await getCollection("blog")).sort((a,b)=>b.data.publishDate.valueOf()-a.data.publishDate.valueOf());const jsonLd={"@context":"https://schema.org","@type":"CollectionPage",name:"Candy AI reviews, comparisons, pricing and safety guides",url:`${site.url}/blog/`,description:"Independent Candy AI comparisons, pricing and token explainers, privacy checklists, and AI companion research.",hasPart:posts.map((post)=>({"@type":"Article",headline:post.data.title,url:`${site.url}/blog/${post.id}/`,datePublished:post.data.publishDate.toISOString()}))};
---
<BaseLayout title="Candy AI Guides: Reviews, Pricing & Alternatives" description="Independent Candy AI guides on AI girlfriends, pricing, tokens, privacy, safety, Lovescape, OurDream AI, and companion alternatives." keywords={["Candy AI review","Candy AI pricing","Candy AI tokens","Candy AI alternatives","AI girlfriend comparison"]} jsonLd={jsonLd}><section class="page-hero candy-info"><div class="ambient-orb"></div><span>CANDY AI RESEARCH NOTES</span><h1>Clear answers for<br/>a personal category.</h1><p>Original Candy AI comparisons and safety guides for adults who want honest tradeoffs on companionship, memory, media, privacy, billing, and total token cost.</p></section><section class="section blog-list"><div class="post-grid">{posts.map((post,index)=><PostCard post={post} index={index}/>)}</div></section></BaseLayout>
