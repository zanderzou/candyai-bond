---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import PostCard from "../components/PostCard.astro";
import { site } from "../data/site";
import heroImage from "../assets/candyai-adult-swimwear-editorial.jpg";
const posts=(await getCollection("blog")).sort((a,b)=>b.data.publishDate.valueOf()-a.data.publishDate.valueOf());
const faqs=[
 {question:"What is Candy AI?",answer:"Candy AI is an adults-only AI companion platform with a catalog of realistic and anime characters, a custom companion builder, text chat, voice features, and image and video media tools."},
 {question:"Is candyai.bond the official Candy AI website?",answer:"No. Candy AI Guide is an independent editorial publication. Links labeled official open candy.ai in a new tab."},
 {question:"How much does Candy AI cost?",answer:"Candy AI offers recurring Premium plans and a token system for selected media and voice actions. Prices and promotions change, so compare the effective billing total—not only the displayed monthly equivalent—on the official checkout."},
 {question:"Does Candy AI offer custom AI girlfriends and boyfriends?",answer:"Yes. The official product promotes both prebuilt and custom realistic or anime companions with controls for appearance, personality, relationship, interests, and voice."},
 {question:"Is Candy AI private?",answer:"The provider describes discreet billing and privacy controls, but companion chats and generated media are still sensitive data. Use invented details, a unique password, two-factor authentication when available, and verify deletion rules before subscribing."},
 {question:"What are good Candy AI alternatives?",answer:"Lovescape is useful for a connected character-to-video workflow; OurDream AI is useful for broader multimedia roleplay. Compare memory, media quality, moderation, deletion, and total token spend using the same test brief."},
];
const jsonLd={"@context":"https://schema.org","@graph":[{"@type":"WebSite","@id":`${site.url}/#website`,name:site.name,url:site.url,description:site.description,inLanguage:"en"},{"@type":"Organization","@id":`${site.url}/#organization`,name:site.name,url:site.url,logo:`${site.url}/favicon.svg`},{"@type":"WebPage","@id":`${site.url}/#webpage`,name:"Candy AI Review: AI Girlfriends, Pricing, Tokens & Safety",url:site.url,isPartOf:{"@id":`${site.url}/#website`},about:["Candy AI","Candy AI review","AI girlfriend","AI companion","Candy AI pricing","Candy AI tokens","Candy AI alternatives"]},{"@type":"FAQPage",mainEntity:faqs.map((faq)=>({"@type":"Question",name:faq.question,acceptedAnswer:{"@type":"Answer",text:faq.answer}}))}]};
---
<BaseLayout title="Candy AI Review: Girlfriends, Pricing & Safety" description={site.description} keywords={["Candy AI","Candy AI review","Candy AI girlfriend","AI girlfriend","AI companion","Candy AI pricing","Candy AI tokens","Candy AI safety","Candy AI alternatives"]} jsonLd={jsonLd}>
  <section class="hero candy-hero">
    <Image class="hero-image" src={heroImage} alt="Adult woman in mint swimwear posing on bright coastal dunes" widths={[640,960,1280,1536]} sizes="100vw" loading="eager" fetchpriority="high" quality={86}/>
    <div class="hero-glow"></div>
    <div class="hero-copy reveal">
      <div class="kicker">Independent Candy AI review · Adults 18+</div>
      <h1>Choose the vibe.<span>Build the connection.</span></h1>
      <p>A clear guide to Candy AI girlfriends and boyfriends, custom companions, chat, voice calls, images, video, Premium pricing, tokens, privacy, and alternatives.</p>
      <div class="hero-actions"><a class="button primary" href="#choose">Explore the companion loop <Icon name="spark"/></a><a class="button ghost" href="/blog/candy-ai-vs-lovescape/">Compare Lovescape</a></div>
      <div class="hero-trust"><span><Icon name="heart"/> 100+ characters promoted</span><span><Icon name="chat"/> Text + voice</span><span><Icon name="wand"/> Image + video</span><span>Independent research</span></div>
    </div>
    <div class="candy-float" aria-hidden="true"><span>VOICE CONNECTION</span><div class="voice-ring"><i></i><b>LIVE</b></div><p>fictional adult companion</p></div>
    <div class="photo-credit">Photo: <a href="https://www.pexels.com/photo/11455866/" target="_blank" rel="noopener noreferrer">Fran Bertucci / Pexels</a> · no endorsement implied</div>
  </section>

  <section class="section intent-grid"><div><div class="section-label">01 / Direct answer</div><h2>What is <span>Candy AI?</span></h2></div><div class="intent-copy"><p class="lead">Candy AI is an adult AI companion platform built around two paths: pick a ready-made realistic or anime character, or create a custom AI girlfriend or boyfriend.</p><p>The experience extends beyond text into voice, generated images, video, Live Action, and group interactions. The useful buying question is not “does it have features?” but whether its memory, character consistency, privacy controls, and token economics fit the way you will actually use it.</p><div class="keyword-line"><span>Candy AI review</span><span>AI girlfriend</span><span>custom AI companion</span><span>Candy AI pricing</span><span>Candy AI tokens</span><span>Candy AI alternatives</span></div></div></section>

  <section class="section candy-path" id="choose"><div class="section-head"><div><div class="section-label">02 / Two ways in</div><h2>Start curated.<br/><span>Or shape every detail.</span></h2></div><p>The catalog is the faster route; the creator is the higher-control route. Test both before deciding what “personal” means to you.</p></div><div class="path-grid"><article><span>01 / DISCOVER</span><h3>Choose from the character catalog</h3><p>Browse realistic and anime companions, compare personality cues, interests, relationship tone, and public profile details, then test the first conversation.</p><ul><li>Fast start</li><li>100+ characters promoted</li><li>AI girlfriends and boyfriends</li></ul></article><article><span>02 / CUSTOMIZE</span><h3>Build a fictional adult companion</h3><p>Direct appearance, ethnicity, hair, body style, personality, relationship, interests, and voice without borrowing a real person’s identity.</p><ul><li>Higher identity control</li><li>Repeatable test brief</li><li>Fictional adults only</li></ul></article></div></section>

  <section class="section" id="features"><div class="section-head"><div><div class="section-label">03 / Companion loop</div><h2>Conversation first.<br/><span>Media when it adds value.</span></h2></div><p>Candy AI packages companionship and generation in one interface. Evaluate the handoffs, not just each feature in isolation.</p></div><div class="feature-grid candy-features"><article class="feature reveal"><div class="feature-icon"><Icon name="chat"/></div><small>CHAT + MEMORY</small><h3>Test a stable personality</h3><p>Use the same facts and boundary twice. Score recall, initiative, repetition, and whether the tone stays aligned.</p><a href="#test">Run the 15-minute test <Icon name="arrow"/></a></article><article class="feature reveal"><div class="feature-icon"><Icon name="heart"/></div><small>VOICE + CALLS</small><h3>Hear the character</h3><p>Voice messages and beta phone-call features can add presence, but metered calling makes a token budget important.</p><a href="#cost">Plan token spend <Icon name="arrow"/></a></article><article class="feature reveal"><div class="feature-icon"><Icon name="wand"/></div><small>IMAGE + VIDEO</small><h3>Keep identity consistent</h3><p>Generate one controlled scene, change one variable at a time, and compare face, clothing, setting, and pose continuity.</p><a href="/blog/candy-ai-vs-ourdream-ai/">Compare media suites <Icon name="arrow"/></a></article></div></section>

  <section class="section candy-test" id="test"><div class="story-board candy-board"><div class="companion-card"><div class="companion-top"><span>15:00 TEST</span><b>MEMORY CHECK</b></div><div class="pulse-orbit"><i></i><i></i><strong>C</strong></div><div class="score-row"><span>PERSONALITY</span><b>__/5</b></div><div class="score-row"><span>RECALL</span><b>__/5</b></div><div class="score-row"><span>MEDIA MATCH</span><b>__/5</b></div></div></div><div class="story-copy"><div class="section-label">04 / Repeatable evaluation</div><h2>One brief.<br/><span>Four useful signals.</span></h2><p>Marketing screenshots cannot show whether a companion fits. A short controlled test can.</p><ol class="steps"><li><span>01</span><div><strong>Create a fictional adult profile</strong><p>Give the companion two traits, one interest, one boundary, and one setting.</p></div></li><li><span>02</span><div><strong>Test recall and initiative</strong><p>Chat for ten turns, revisit the boundary, and note generic or contradictory replies.</p></div></li><li><span>03</span><div><strong>Add one voice and media action</strong><p>Record the token cost and compare whether voice, image, and chat still feel like the same character.</p></div></li></ol></div></section>

  <section class="section cost-section" id="cost"><div class="cost-copy"><div class="section-label">05 / Candy AI pricing</div><h2>Read the billing total.<br/><span>Then budget tokens.</span></h2><p>As checked September 21, 2026, the official subscription page displayed monthly, quarterly, and annual Premium options. Longer plans showed a lower monthly equivalent but charge the full term and renew automatically unless cancelled.</p><p>Premium was shown with unlimited text messages and 100 monthly tokens. Selected media and voice actions can consume tokens; the official chat interface described beta AI phone calls at 3 tokens per minute. Verify the live checkout because pricing, promotions, inclusions, and token rates can change.</p><a class="button ghost" href="https://candy.ai/subscriptions" rel="noopener" target="_blank">Check official pricing <Icon name="arrow"/></a></div><div class="budget-card"><span>BEFORE YOU PAY</span><h3>Build a real monthly estimate</h3><div><b>01</b><p>Subscription total and renewal date</p></div><div><b>02</b><p>Included tokens and expiration rules</p></div><div><b>03</b><p>Calls, images, and video per week</p></div><div><b>04</b><p>Extra token pack price</p></div><div><b>05</b><p>Cancellation and refund terms</p></div></div></section>

  <section class="section" id="compare"><div class="section-head"><div><div class="section-label">06 / Comparison snapshot</div><h2>Candy AI vs.<br/><span>companion alternatives.</span></h2></div><p>Use one identical character brief across platforms so polish does not hide tradeoffs in control, continuity, and cost.</p></div><div class="compare-table"><table><thead><tr><th>Platform</th><th>Best fit</th><th>Workflow emphasis</th><th>Cost question</th><th>Guide</th></tr></thead><tbody><tr><td><strong>Candy AI</strong></td><td>Polished choice between ready-made and custom companions</td><td>Chat, voice, calls, images, video</td><td>Premium plus tokens</td><td><span class="badge">Guided companion</span></td></tr><tr><td><strong>Lovescape</strong></td><td>Connected character-to-image-to-video direction</td><td>Creator-led media continuity</td><td>Premium plus Chips</td><td><a href="/blog/candy-ai-vs-lovescape/">Full comparison →</a></td></tr><tr><td><strong>OurDream AI</strong></td><td>Broad multimedia roleplay and generation</td><td>Character-led creative suite</td><td>Plan plus coins</td><td><a href="/blog/candy-ai-vs-ourdream-ai/"><span class="badge alt">Compare suites</span></a></td></tr></tbody></table></div></section>

  <section class="section privacy" id="privacy"><div class="privacy-copy"><div class="section-label">07 / Privacy and consent</div><h2>Treat companion data<br/><span>as sensitive by default.</span></h2><p>Candy AI’s privacy notice says account details, conversation inputs, outputs, images, video, and voice may be processed. Provider security claims are useful context, not a substitute for your own data minimization.</p><a class="button ghost" href="/blog/is-candy-ai-safe/">Open the safety checklist <Icon name="arrow"/></a></div><div class="privacy-card"><span>PRIVATE-BY-DEFAULT</span><h3>Five habits before chatting</h3><ul><li><b>01</b><span>Use a unique password and enable 2FA if offered.</span></li><li><b>02</b><span>Use an invented persona; omit real names and addresses.</span></li><li><b>03</b><span>Upload only media you created or may legally use.</span></li><li><b>04</b><span>Check conversation, media, and account deletion paths.</span></li><li><b>05</b><span>Keep a record of renewal and token purchases.</span></li></ul></div></section>

  <section class="section"><div class="section-head"><div><div class="section-label">08 / Candy AI guides</div><h2>Original comparisons for<br/><span>real decisions.</span></h2></div><a class="button ghost" href="/blog/">Browse all guides <Icon name="arrow"/></a></div><div class="post-grid">{posts.map((post,index)=><PostCard post={post} index={index}/>)}</div></section>
  <section class="section faq"><div><div class="section-label">09 / Frequently asked</div><h2>Candy AI<br/><span>questions, answered.</span></h2></div><div class="faq-list">{faqs.map((faq)=><details><summary>{faq.question}<span>+</span></summary><p>{faq.answer}</p></details>)}</div></section>
  <section class="section final-cta candy-cta"><div><div class="section-label">MAKE THE COMPARISON FAIR</div><h2>Test the connection<br/>before funding the extras.</h2><p>Compare personality, recall, voice, media continuity, token spend, billing, consent, and deletion—then verify the current offer on the official site.</p></div><a class="button primary" href={site.officialUrl} rel="noopener" target="_blank">Visit official Candy AI <Icon name="arrow"/></a></section>
</BaseLayout>
