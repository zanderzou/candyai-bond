---
import type { CollectionEntry } from "astro:content";
import Icon from "./Icon.astro";
import { site } from "../data/site";
interface Props { posts: CollectionEntry<"blog">[]; }
const { posts } = Astro.props;
---
<footer><div class="footer-grid">
  <div><a class="brand" href="/"><span class="brand-icon">C</span><strong>Candy <span>AI</span></strong></a><p>Independent research on Candy AI girlfriends, custom companions, chat, voice calls, images, video, tokens, privacy, pricing, safety, and alternatives.</p></div>
  <div><h3>Explore</h3><a href="/#choose">Candy AI characters</a><a href="/#features">Chat and media</a><a href="/#compare">Candy AI alternatives</a><a href={site.officialUrl} rel="noopener" target="_blank">Official Candy AI <Icon name="arrow" /></a></div>
  <div><h3>Latest guides</h3>{posts.slice(0,3).map((post)=><a href={`/blog/${post.id}/`}>{post.data.title}</a>)}</div>
  <div><h3>Information</h3><a href="/about/">About</a><a href="/privacy/">Privacy</a><a href="/terms/">Terms</a><a href="/editorial-policy/">Editorial policy</a><a href="/contact/">Contact</a></div>
</div><div class="footer-bottom"><span>© <span data-year>2026</span> Candy AI</span><span>Independent · Not affiliated with Candy AI</span><span>Adults 18+ · No chat, uploads, or payments collected</span></div></footer>
